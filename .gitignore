# ==========================================
# SAI AGRO INDUSTRIES
# Next.js + React + TypeScript Project
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js generated files
/.next/
/out/

# Production build
/build
/dist

# Environment variables - NEVER PUSH SECRETS
.env
.env.*
!.env.example

# Vercel deployment files
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts

# Testing and coverage
/coverage/
/.nyc_output/

# Cache
.cache/
.eslintcache
.stylelintcache

# Turbo cache (if used)
/.turbo/

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Editor settings
.vscode/*
!.vscode/extensions.json
.idea/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*.bak

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Debug files
npm-debug.log*
yarn-debug.log*
